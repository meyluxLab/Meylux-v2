# Non-secret local Docker/Database Foundation inputs.
# Copy to .env and replace all local-only values before starting Compose.
MEYLUX_DB_NAME=meylux
MEYLUX_DB_USER=meylux_admin
MEYLUX_DB_PASSWORD=change-me-local-only
MEYLUX_APP_PASSWORD=change-me-app-local-only
MEYLUX_BACKUP_PASSWORD=change-me-backup-local-only
